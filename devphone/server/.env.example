# Copy to .env and fill in. Generate tokens with: openssl rand -hex 24
DEVPHONE_DOMAIN=phone.example.com
DEVPHONE_TOKEN=
# Optional watch-only token you can share widely.
DEVPHONE_VIEW_TOKEN=
# Phone screen. 720x1560 @ 320dpi is a mid-range phone and keeps the stream light.
PHONE_WIDTH=720
PHONE_HEIGHT=1560
PHONE_DPI=320
REDROID_TAG=13.0.0-latest
